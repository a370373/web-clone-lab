{
  "manifest_version": 3,

  "name": "Web Clone Lab",

  "version": "0.1.0",

  "description": "A browser-based frontend snapshot and web experimentation laboratory.",

  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_title": "Web Clone Lab",
    "default_popup": "popup/popup.html"
  },

  "background": {
    "service_worker": "background/background.js"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
